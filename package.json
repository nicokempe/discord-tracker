{
  "name": "discord-tracker",
  "version": "2026.10.1",
  "description": "Advanced Discord Bot with Spotify Integration: Tracks and broadcasts user activities in real-time, offering custom status updates and music tracking features.",
  "main": "dist/Bot.js",
  "scripts": {
    "start": "pnpm run build && node dist/Bot.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test tests/*.test.cjs",
    "release:prepare": "node scripts/release/prepare-release.mts",
    "release:check": "tsc --project scripts/release/tsconfig.json && node --test scripts/release/*.test.mts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nicokempe/discord-tracker.git"
  },
  "keywords": [
    "discord",
    "typescript"
  ],
  "author": {
    "name": "Nico Kempe",
    "email": "kontakt@nicokempe.de",
    "url": "www.nicokempe.de"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "changelogen": "^0.6.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
