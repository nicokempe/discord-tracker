{
  "name": "discord-tracker",
  "version": "2026.5.0",
  "description": "Advanced Discord Bot with Spotify Integration: Tracks and broadcasts user activities in real-time, offering custom status updates and music tracking features.",
  "main": "dist/Bot.js",
  "scripts": {
    "start": "pnpm run build && node dist/Bot.js",
    "build": "tsc",
    "prerelease": "pnpm install && pnpm run build",
    "release": "npx changelogen@latest --release --patch --bump --push",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test tests/*.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "github.com/nicokempe/discord-tracker"
  },
  "keywords": [
    "discord",
    "typescript"
  ],
  "author": {
    "name": "Nico Kempe",
    "email": "kontakt@nicokempe.de",
    "url": "www.nicokempe.de"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "changelogen": "^0.6.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
